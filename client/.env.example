# Production Environment Configuration

# Local Development URL in client/.env:
# VITE_API_BASE_URL=http://localhost:5000/api

# When hosting (Render, Vercel, Railway, Heroku, Netlify):
# Change VITE_API_BASE_URL to your hosted backend URL in your deployment platform settings:
# Example: VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
